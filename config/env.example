# ============================================================
# Recklein Case Engine — Environment Variables
# Copy this file to .env at the project root and fill in values.
# Never commit .env to source control.
# ============================================================

# ------------------------------------------------------------
# Supabase (required)
# Find in: Supabase Dashboard → Project Settings → API
# ------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ------------------------------------------------------------
# Anthropic (required)
# Find in: console.anthropic.com → API Keys
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------
# Primary Subject
# UUID of John Recklein's record in the people table.
# Run `npm run check` after seed to confirm.
# ------------------------------------------------------------
PRIMARY_PERSON_ID=

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
PORT=3000
NODE_ENV=development       # development | production

# CORS_ORIGIN controls which origins receive CORS headers.
# Use '*' for open access during development.
# Set to your front-end URL in production (e.g. https://app.example.com).
CORS_ORIGIN=*

# ------------------------------------------------------------
# Logging
# LOG_LEVEL is informational — the logger currently emits INFO/WARN/ERROR
# regardless, but setting this to 'debug' enables verbose module output
# where supported.
# ------------------------------------------------------------
LOG_LEVEL=info             # info | debug
